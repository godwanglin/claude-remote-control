{
  "name": "@devnuby/crc",
  "version": "1.0.11",
  "description": "Remote control client and Discord bot bridge for Claude Desktop / Claude Code",
  "type": "module",
  "main": "dist/bot.js",
  "bin": {
    "crc": "bin/crc.js"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godwanglin/claude-remote-control.git"
  },
  "bugs": {
    "url": "https://github.com/godwanglin/claude-remote-control/issues"
  },
  "homepage": "https://github.com/godwanglin/claude-remote-control#readme",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "start": "tsx src/bot.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "crc": "node bin/crc.js",
    "tray": "node bin/crc.js tray"
  },
  "keywords": [
    "claude",
    "claude-desktop",
    "claude-code",
    "remote-control",
    "discord",
    "bot",
    "cli",
    "bridge"
  ],
  "author": "devnuby",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
